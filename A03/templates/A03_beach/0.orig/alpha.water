/*--------------------------------*- C++ -*----------------------------------*\
  =========                 |
  \\      /  F ield         | OpenFOAM: The Open Source CFD Toolbox
   \\    /   O peration     |
    \\  /    A nd           | Waves on a sloping beach (A03)
     \\/     M anipulation  |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;      // still water below z = 0: set by setExprFields

boundaryField
{
    inlet
    {
        type            waveAlpha;      // the wavemaker (constant/waveProperties)
        value           uniform 0;
    }
    bed             { type zeroGradient; }
    outlet          { type zeroGradient; }
    atmosphere
    {
        type            inletOutlet;
        inletValue      uniform 0;
        value           uniform 0;
    }
    frontAndBack    { type empty; }
}

// ************************************************************************* //
