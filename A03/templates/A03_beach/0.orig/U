FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type            waveVelocity;   // the wavemaker (constant/waveProperties)
        value           uniform (0 0 0);
    }
    bed             { type slip; }
    outlet
    {
        type            waveVelocity;   // absorbing outlet (constant/waveProperties)
        value           uniform (0 0 0);
    }
    atmosphere
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }
    frontAndBack    { type empty; }
}

