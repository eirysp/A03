FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "../parameters"

scale   1;

// Three sections in x (flat bed, slope, shelf), each with three blocks in z:
// below the band (cells that follow the bed), the band zLow <= z <= zHigh
// (uniform cells dx by dz) and the air above it. Vertices: x station i,
// z level j (bed, zLow, zHigh, zTop), y = 0 or dy.
zDeep       #eval{ -$d };
zShelfBed   #eval{ -$dShelf };

// Expansion ratios (last cell / first cell, upwards) that make the cells next
// to the band the same height as the band's (dz)
rBedDeep    #eval{ $dzBand/(2*($zLow + $d)/$nzBed - $dzBand) };
rBedShelf   1;      // only zLow + dShelf = 0.5 m below the band over the shelf: uniform
rAir        #eval{ (2*($zTop - $zHigh)/$nzAir - $dzBand)/$dzBand };

vertices
(
    (0        0   $zDeep    )   //  0: x0 z0 y0
    (0        $dy $zDeep    )   //  1: x0 z0 y1
    (0        0   $zLow     )   //  2: x0 z1 y0
    (0        $dy $zLow     )   //  3: x0 z1 y1
    (0        0   $zHigh    )   //  4: x0 z2 y0
    (0        $dy $zHigh    )   //  5: x0 z2 y1
    (0        0   $zTop     )   //  6: x0 z3 y0
    (0        $dy $zTop     )   //  7: x0 z3 y1
    ($xToe    0   $zDeep    )   //  8: x1 z0 y0
    ($xToe    $dy $zDeep    )   //  9: x1 z0 y1
    ($xToe    0   $zLow     )   // 10: x1 z1 y0
    ($xToe    $dy $zLow     )   // 11: x1 z1 y1
    ($xToe    0   $zHigh    )   // 12: x1 z2 y0
    ($xToe    $dy $zHigh    )   // 13: x1 z2 y1
    ($xToe    0   $zTop     )   // 14: x1 z3 y0
    ($xToe    $dy $zTop     )   // 15: x1 z3 y1
    ($xShelf  0   $zShelfBed)   // 16: x2 z0 y0
    ($xShelf  $dy $zShelfBed)   // 17: x2 z0 y1
    ($xShelf  0   $zLow     )   // 18: x2 z1 y0
    ($xShelf  $dy $zLow     )   // 19: x2 z1 y1
    ($xShelf  0   $zHigh    )   // 20: x2 z2 y0
    ($xShelf  $dy $zHigh    )   // 21: x2 z2 y1
    ($xShelf  0   $zTop     )   // 22: x2 z3 y0
    ($xShelf  $dy $zTop     )   // 23: x2 z3 y1
    ($xEnd    0   $zShelfBed)   // 24: x3 z0 y0
    ($xEnd    $dy $zShelfBed)   // 25: x3 z0 y1
    ($xEnd    0   $zLow     )   // 26: x3 z1 y0
    ($xEnd    $dy $zLow     )   // 27: x3 z1 y1
    ($xEnd    0   $zHigh    )   // 28: x3 z2 y0
    ($xEnd    $dy $zHigh    )   // 29: x3 z2 y1
    ($xEnd    0   $zTop     )   // 30: x3 z3 y0
    ($xEnd    $dy $zTop     )   // 31: x3 z3 y1
);

blocks
(
    hex (0 8 9 1 2 10 11 3) ($nxFlat 1 $nzBed) edgeGrading (1 1 1 1  1 1 1 1  $rBedDeep $rBedDeep $rBedDeep $rBedDeep)   // flat, below band
    hex (2 10 11 3 4 12 13 5) ($nxFlat 1 $nzBand) simpleGrading (1 1 1)   // flat, band
    hex (4 12 13 5 6 14 15 7) ($nxFlat 1 $nzAir) simpleGrading (1 1 $rAir)   // flat, air
    hex (8 16 17 9 10 18 19 11) ($nxSlope 1 $nzBed) edgeGrading (1 1 1 1  1 1 1 1  $rBedDeep $rBedShelf $rBedShelf $rBedDeep)   // slope, below band
    hex (10 18 19 11 12 20 21 13) ($nxSlope 1 $nzBand) simpleGrading (1 1 1)   // slope, band
    hex (12 20 21 13 14 22 23 15) ($nxSlope 1 $nzAir) simpleGrading (1 1 $rAir)   // slope, air
    hex (16 24 25 17 18 26 27 19) ($nxShelf 1 $nzBed) edgeGrading (1 1 1 1  1 1 1 1  $rBedShelf $rBedShelf $rBedShelf $rBedShelf)   // shelf, below band
    hex (18 26 27 19 20 28 29 21) ($nxShelf 1 $nzBand) simpleGrading (1 1 1)   // shelf, band
    hex (20 28 29 21 22 30 31 23) ($nxShelf 1 $nzAir) simpleGrading (1 1 $rAir)   // shelf, air
);

boundary
(
    inlet    // the wavemaker
    {
        type    patch;
        faces
        (
            (0 2 3 1)
            (2 4 5 3)
            (4 6 7 5)
        );
    }
    outlet    // absorbs the waves that cross the shelf
    {
        type    patch;
        faces
        (
            (24 25 27 26)
            (26 27 29 28)
            (28 29 31 30)
        );
    }
    bed
    {
        type    wall;
        faces
        (
            (0 1 9 8)
            (8 9 17 16)
            (16 17 25 24)
        );
    }
    atmosphere
    {
        type    patch;
        faces
        (
            (6 14 15 7)
            (14 22 23 15)
            (22 30 31 23)
        );
    }
    frontAndBack
    {
        type    empty;
        faces
        (
            (0 8 10 2)
            (1 3 11 9)
            (2 10 12 4)
            (3 5 13 11)
            (4 12 14 6)
            (5 7 15 13)
            (8 16 18 10)
            (9 11 19 17)
            (10 18 20 12)
            (11 13 21 19)
            (12 20 22 14)
            (13 15 23 21)
            (16 24 26 18)
            (17 19 27 25)
            (18 26 28 20)
            (19 21 29 27)
            (20 28 30 22)
            (21 23 31 29)
        );
    }
);

