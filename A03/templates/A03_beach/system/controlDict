FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "../parameters"

application     interFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         $endTime;

deltaT          1e-4;                // first time step; then set by maxCo
adjustTimeStep  yes;
maxCo           $maxCo;
maxAlphaCo      $maxCo;
maxDeltaT       #eval{ $T/100 };

writeControl    adjustable;          // write exactly every writeInterval
writeInterval   $endTime;            // all fields only at endTime: the frames for
                                     // ParaView are written by writeFields below
purgeWrite      0;                   // keep every time folder (purgeWrite would
                                     // also delete the folders of writeFields)
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   8;
runTimeModifiable yes;

functions
{
    // The fields for ParaView (alpha.water, U, p_rgh), 40 times per period over
    // the whole run: about 1.3 MB per time folder, 0.95 GB in all. The other
    // fields (p, phi, alphaPhi0.water) are written only at endTime.
    writeFields
    {
        type            writeObjects;
        libs            (utilityFunctionObjects);
        writeControl    adjustableRunTime;
        writeInterval   #eval{ $T/40 };
        writeOption     anyWrite;
        objects         (alpha.water U p_rgh);
    }

    // The free surface (alpha.water = 0.5) as a line of points (x, y, z = eta),
    // 40 times per period: postProcessing/freeSurface/<time>/freeSurface.raw
    freeSurface
    {
        type            surfaces;
        libs            (sampling);
        writeControl    adjustableRunTime;
        writeInterval   #eval{ $T/40 };
        surfaceFormat   raw;
        fields          ();
        surfaces
        {
            freeSurface
            {
                type        isoSurface;
                isoField    alpha.water;
                isoValue    0.5;
                interpolate true;
            }
        }
    }
}

