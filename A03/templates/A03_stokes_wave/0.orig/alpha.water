/*--------------------------------*- C++ -*----------------------------------*\
  =========                 |
  \\      /  F ield         | OpenFOAM: The Open Source CFD Toolbox
   \\    /   O peration     |
    \\  /    A nd           | Stokes wave in a periodic domain (A03)
     \\/     M anipulation  |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      alpha.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;      // set by setExprFields (system/setExprFieldsDict)

boundaryField
{
    left            { type cyclic; }
    right           { type cyclic; }
    bed             { type zeroGradient; }
    atmosphere
    {
        type            inletOutlet;    // air flows in, anything flows out
        inletValue      uniform 0;
        value           uniform 0;
    }
    frontAndBack    { type empty; }
}

// ************************************************************************* //
