FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "../parameters"

scale   1;

// Three blocks in z: bed -> -zBand (graded), the surface band (uniform cells,
// where the free surface moves) and zBand -> zTop (graded).
zb      #eval{ -$d };
z1      #eval{ -$zBand };
z2      $zBand;

// Expansion ratios (last cell / first cell, upwards) that make the cells of
// the graded blocks the same height as those of the band where they meet it
bedRatio #eval{ $dzBand/(2*($d - $zBand)/$nzBed - $dzBand) };
airRatio #eval{ (2*($zTop - $zBand)/$nzAir - $dzBand)/$dzBand };

vertices
(
    (0 0 $zb)     ($lambda 0 $zb)     ($lambda $dy $zb)     (0 $dy $zb)
    (0 0 $z1)     ($lambda 0 $z1)     ($lambda $dy $z1)     (0 $dy $z1)
    (0 0 $z2)     ($lambda 0 $z2)     ($lambda $dy $z2)     (0 $dy $z2)
    (0 0 $zTop)   ($lambda 0 $zTop)   ($lambda $dy $zTop)   (0 $dy $zTop)
);

blocks
(
    hex (0 1 2 3 4 5 6 7)       ($nx 1 $nzBed)  simpleGrading (1 1 $bedRatio)
    hex (4 5 6 7 8 9 10 11)     ($nx 1 $nzBand) simpleGrading (1 1 1)
    hex (8 9 10 11 12 13 14 15) ($nx 1 $nzAir)  simpleGrading (1 1 $airRatio)
);

boundary
(
    left
    {
        type            cyclic;
        neighbourPatch  right;
        faces           ((0 4 7 3) (4 8 11 7) (8 12 15 11));
    }
    right
    {
        type            cyclic;
        neighbourPatch  left;
        faces           ((1 2 6 5) (5 6 10 9) (9 10 14 13));
    }
    bed
    {
        type            wall;
        faces           ((0 3 2 1));
    }
    atmosphere
    {
        type            patch;
        faces           ((12 13 14 15));
    }
    frontAndBack
    {
        type            empty;
        faces           ((0 1 5 4) (4 5 9 8) (8 9 13 12)
                         (3 7 6 2) (7 11 10 6) (11 15 14 10));
    }
);

